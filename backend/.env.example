APP_ENV=development
APP_NAME=FM LUXE API
APP_VERSION=0.1.0
API_V1_PREFIX=/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Direct connection for Alembic migrations; pulled automatically by Neon.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
CORS_ORIGINS=http://localhost:4000
LOG_LEVEL=INFO
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
INITIAL_ADMIN_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
CATALOG_BUCKET=catalog-images
