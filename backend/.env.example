APP_ENV=development
APP_NAME=FM LUXE API
APP_VERSION=0.1.0
API_V1_PREFIX=/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Direct connection for Alembic migrations; pulled automatically by Neon.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
CORS_ORIGINS=http://localhost:4000
LOG_LEVEL=INFO
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
INITIAL_ADMIN_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
CATALOG_BUCKET=catalog-images

# Phase 4 is sandbox-only. Values are server-only; never paste them into chat.
BACHS_API_KEY=
BACHS_ORGANIZATION_ID=
BACHS_WEBHOOK_SECRET=
# Bachs requires public HTTPS return URLs; localhost is rejected.
BACHS_SUCCESS_URL=https://your-store.example/order-success
BACHS_CANCEL_URL=https://your-store.example/checkout
